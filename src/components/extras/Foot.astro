---
import Container from "@layouts/Container.astro";
import { Mail, Phone, MapPin, Calendar, Instagram, Facebook } from "@lucide/astro";
import { nuevas } from "@lib/propiedades.ts";
import { menu } from "@lib/menu.ts";
import Lista from "@components/propiedades/Lista.astro";
import type { Propiedad } from "@interfaces/Propiedad";
---

<div class="foot-shell">
  <Container>
    <div class="foot-grid text-white">
      <section class="foot-panel">
        <h3>Contactanos</h3>
        <p class="text-sm text-gray-300">
          Venta, arriendo y administracion inmobiliaria con acompanamiento
          comercial y juridico para cada operacion.
        </p>
        <ul class="contact-list">
          <li>
            <MapPin color="#f87171" size="18" />
            <span>Independencia 1725 of. 504, Edificio Plaza Victoria, Valparaiso.</span>
          </li>
          <li>
            <Phone color="#f87171" size="18" />
            <span>+56 9 9599 9796</span>
          </li>
          <li>
            <Mail color="#f87171" size="18" />
            <span>contacto@marsolpropiedades.cl</span>
          </li>
          <li>
            <Calendar color="#f87171" size="18" />
            <span>Lunes a Viernes: 09:00 - 19:00</span>
          </li>
        </ul>
      </section>

      <section class="foot-panel">
        <h3>Propiedades Nuevas</h3>
        <ul class="list rounded-box w-full">
          {
            nuevas.slice(0, 6).map((propiedad: Propiedad) => (
              <Lista
                imagen={`https://marsolpropiedades.cl/images/propiedades/${propiedad.slug}/mini.webp`}
                ciudad={propiedad.direccion.ciudad}
                direccion={propiedad.direccion.direccion}
                slug={propiedad.slug}
              />
            ))
          }
        </ul>
      </section>

      <section class="foot-panel">
        <nav>
          <h3>Menu</h3>
          <ul class="list">
            {
              menu.map((item: { name: string; href: string }) => (
                <li>
                  <a href={item.href} class="list-row uppercase hover:bg-zinc-700 rounded-md">
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>
    </div>
  </Container>

  <div class="foot-bottom">
    <Container>
      <footer class="foot-bottom-inner">
        <aside class="brand-wrap">
          <img
            src="/logo-nuevo-bl.svg"
            alt="Logo Marsol Propiedades"
            class="h-10 w-auto"
          />
          <p>Marsol Propiedades © {new Date().getFullYear()} - Todos los derechos reservados.</p>
        </aside>
        <nav class="social-links">
          <a href="https://www.instagram.com/marsolpropiedades/" target="_blank" aria-label="Instagram">
            <Instagram size="22" />
          </a>
          <a href="https://www.facebook.com/propiedadesmarsol" target="_blank" aria-label="Facebook">
            <Facebook size="22" />
          </a>
        </nav>
      </footer>
    </Container>
  </div>
</div>

<style>
  .foot-shell {
    background: linear-gradient(180deg, #20232d 0%, #17191f 100%);
    border-top: 1px solid rgba(248, 113, 113, 0.15);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2rem 0;
  }

  .foot-panel {
    background: rgba(19, 21, 27, 0.78);
    border: 1px solid rgba(248, 113, 113, 0.18);
    border-radius: 0.9rem;
    padding: 1rem;
  }

  .foot-panel h3 {
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
    color: #fecaca;
  }

  .contact-list {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.6rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: #e5e7eb;
    font-size: 0.93rem;
  }

  .foot-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: #0f1115;
  }

  .foot-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 0;
    color: #d1d5db;
  }

  .brand-wrap {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }

  .brand-wrap p {
    margin: 0;
    font-size: 0.9rem;
  }

  .social-links {
    display: flex;
    gap: 0.65rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    background: rgba(239, 68, 68, 0.18);
    color: #fecaca;
    transition: background 0.2s ease;
  }

  .social-links a:hover {
    background: rgba(220, 38, 38, 0.8);
    color: white;
  }

  @media (min-width: 1024px) {
    .foot-grid {
      grid-template-columns: 1.2fr 1fr 0.8fr;
      padding: 2.2rem 0;
    }

    .foot-bottom-inner {
      flex-direction: row;
    }
  }
</style>
