---
import { categoria, ciudad, propiedadesBusquedaJson } from "@lib/propiedades";
// import Tags from "@components/propiedad/Tags.astro";
import Ultimas from "@components/propiedad/Ultimas.astro";
---

<div id="buscador-lateral" class="card rounded-md">
  <div class="card-body">
    <form id="buscadorLateralForm" action="" class="hidden md:block">
      <fieldset class="fieldset p-0 mb-1">
        <select name="categoria" class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Tipo</option>
          {categoria.map((cate) => <option value={cate}>{cate}</option>)}
        </select>
      </fieldset>
      <fieldset class="fieldset p-0 mb-1">
        <select name="ciudad" class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Ciudad</option>
          {ciudad.map((city) => <option value={city}>{city}</option>)}
        </select>
      </fieldset>
      <fieldset class="fieldset p-0 mb-1">
        <select name="operacion" class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Operación</option>
          <option value="Venta">Venta</option>
          <option value="Arriendo">Arriendo</option>
        </select>
      </fieldset>
      <a
        id="buscarPage"
        class="btn btn-lg bg-red-400 hover:bg-red-700 text-white rounded-md w-full mt-1"
      >
        Buscar
      </a>
    </form>
    <!-- <div class="divider hidden md:block"></div>
    <Tags /> -->
    <div class="hidden lg:block">
      <div class="divider"></div>
      <Ultimas />
    </div>
  </div>
</div>

<script
  type="application/json"
  id="datos-buscador-lateral"
  set:html={propiedadesBusquedaJson}
/>

<script>
  import { initBuscador } from "@lib/buscador";
  initBuscador("buscadorLateralForm", "buscarPage", "propiedadesPage", "datos-buscador-lateral");
</script>

<style is:global>
  #propiedadesPage .img-card {
    height: 250px;
  }
</style>
