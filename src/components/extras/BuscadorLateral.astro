---
import { categoria, ciudad } from "@lib/propiedades.ts";
// import Tags from "@components/propiedad/Tags.astro";
import Ultimas from "@components/propiedad/Ultimas.astro";
---

<div id="buscador-lateral" class="card rounded-md">
  <div class="card-body">
    <form action="" class="hidden md:block">
      <fieldset class="fieldset p-0 mb-1">
        <select class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Tipo</option>
          {categoria.map((cate) => <option value={cate}>{cate}</option>)}
        </select>
      </fieldset>
      <fieldset class="fieldset p-0 mb-1">
        <select class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Ciudad</option>
          {ciudad.map((city) => <option value={city}>{city}</option>)}
        </select>
      </fieldset>
      <fieldset class="fieldset p-0 mb-1">
        <select class="select select-ghost w-full text-lg">
          <option disabled selected value="">Elija Operación</option>
          <option value="Venta">Venta</option>
          <option value="Arriendo">Arriendo</option>
        </select>
      </fieldset>
      <a
        id="buscarPage"
        class="btn btn-lg bg-red-400 hover:bg-red-700 text-white rounded-md w-full mt-1"
      >
        Buscar
      </a>
    </form>
    <!-- <div class="divider hidden md:block"></div>
    <Tags /> -->
    <div class="hidden lg:block">
      <div class="divider"></div>
      <Ultimas />
    </div>
  </div>
</div>

<script>
  import { propiedades } from "../../lib/propiedades.ts";
  const resultados = document.getElementById("propiedadesPage");
  const buscarPage = document.getElementById("buscarPage");

  buscarPage.addEventListener("click", function (e) {
    realizarBusqueda();
  });

  function realizarBusqueda() {
    resultados.innerHTML = "<p>Buscando...</p>";

    const selects = document.querySelectorAll("select");
    const categoria = selects[0].value;
    const ciudad = selects[1].value;
    const operacion = selects[2].value;

    // Filtrar propiedades
    const propiedadesFiltradas = propiedades.filter((propiedad) => {
      let aux = true;
      if (categoria) {
        console.log(propiedad.categoriaGraphql.categoria, categoria);
        aux = propiedad.categoriaGraphql.categoria[0] === categoria;
        if (!aux) return false;
      }
      if (ciudad) {
        aux = propiedad.direccion.ciudad === ciudad;
        if (!aux) return false;
      }
      if (operacion) {
        aux = propiedad.operacion.operacion === operacion;
        if (!aux) return false;
      }
      return aux;
    });

    resultados.innerHTML = "";

    if (propiedadesFiltradas.length === 0) {
      resultados.innerHTML =
        "<div class='text-center p-4'><p class='text-gray-500'>No se encontraron resultados para los criterios seleccionados</p></div>";
    } else {
      propiedadesFiltradas.forEach((propiedad) => {
        const cleanSlug = propiedad.slug.startsWith('/') ? propiedad.slug.slice(1) : propiedad.slug;
        resultados.innerHTML += `
          <a href="/propiedades/${cleanSlug}" class="col-span-1">
            <div class="card shadow-lg col-span-1 transition-shadow duration-300 rounded-md">
              <figure class="relative">
                <img
                  src="https://marsolpropiedades.cl/images/propiedades/${cleanSlug}/mini.webp"
                  alt="${propiedad.direccion.direccion}"
                  class="w-full object-cover hover:scale-110 transition-all duration-300 img-card"
                />
                <div class="card-body bg-gradient-to-t from-black/80 to-transparent absolute bottom-0 w-full p-4">
                  <div class="badge border-none text-white bg-red-800 px-2 w-fit">
                    ${propiedad.precio.precio ? `$${propiedad.precio.precio} CLP` : `${propiedad.precio.precioUf} UF`}
                  </div>
                </div>
              </figure>
              <div class="bg-zinc-700 px-2 py-1">${propiedad.categoriaGraphql.categoria} en ${propiedad.operacion.operacion}</div>
              <div class="card-body p-0 bg-neutral-800 rounded-br-md rounded-bl-md">
                <ul class="list">
                  <li class="list-row flex flex-col gap-1 h-20">
                    <header class="overflow-hidden text-ellipsis">
                      <h2 class="card-title">${propiedad.title}</h2>
                    </header>
                    <div class="flex justify-center items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="red" class="bi bi-geo-alt" viewBox="0 0 16 16">
  <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
  <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
</svg>
                      <p>${propiedad.direccion.ciudad}</p>
                    </div>
                  </li>
                  <li class="list-row p-2">
                    <div class="grid gap-1">
                      ${propiedad.datos.areaTotal ? `<div class="tooltip" data-tip="Área Total: ${propiedad.datos.areaTotal} m²"><span class="flex items-center badge bg-red-700 hover:bg-red-800 border-none text-white text-xs rounded-sm">${propiedad.datos.areaTotal} m²</span></div>` : ""}
                      ${propiedad.datos.banos ? `<div class="tooltip" data-tip="${propiedad.datos.banos > 1 ? `${propiedad.datos.banos} Baños` : "1 Baño"}"><span class="flex items-center badge bg-red-700 hover:bg-red-800 border-none text-white text-xs rounded-sm">${propiedad.datos.banos} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bath-icon lucide-bath"><path d="M10 4 8 6"/><path d="M17 19v2"/><path d="M2 12h20"/><path d="M7 19v2"/><path d="M9 5 7.621 3.621A2.121 2.121 0 0 0 4 5v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/></svg></span></div>` : ""}
                      ${propiedad.datos.habitaciones ? `<div class="tooltip" data-tip="${propiedad.datos.habitaciones > 1 ? `${propiedad.datos.habitaciones} Dormitorios` : "1 Dormitorio"}"><span class="flex items-center badge bg-red-700 hover:bg-red-800 border-none text-white text-xs rounded-sm">${propiedad.datos.habitaciones} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bed-double-icon lucide-bed-double"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v6"/><path d="M2 18h20"/></svg></span></div>` : ""}
                      ${
                        propiedad.datos.estacionamiento
                          ? `<div class="tooltip" data-tip="${propiedad.datos.estacionamiento > 1 ? `${propiedad.datos.estacionamiento} Estacionamientos` : "1 Estacionamiento"}"><span class="badge bg-red-700 hover:bg-red-800 border-none text-white text-xs rounded-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-car-icon lucide-car"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg></span></div>`
                          : ""
                      }
                      ${
                        propiedad.datos.bodega
                          ? `<div class="tooltip" data-tip="${propiedad.datos.bodega > 1 ? `${propiedad.datos.bodega} Bodegas` : "1 Bodega"}"><span class="badge bg-red-700 hover:bg-red-800 border-none text-white text-xs rounded-sm">Bod</span></div>`
                          : ""
                      }
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </a>
        `;
      });
    }
  }
</script>

<style is:global>
  #propiedadesPage .img-card {
    height: 250px;
  }
</style>
