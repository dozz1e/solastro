---
const { mapa } = Astro.props;

// We use the address directly for the Google Maps iframe.
// This is much more reliable during build than hitting Nominatim API which has strict rate limits (1 req/s)
// and often returns 429 Too Many Requests during parallel Astro builds.
const mapUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapa)}&z=15&output=embed`;
---

{
  mapa && (
    <div class="mb-2">
      <div class="card card-xl shadow-sm bg-stone-900 mt-2 md:mt-0 p-6 rounded-md">
        <iframe
          width="100%"
          height="450"
          style="border:0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src={mapUrl}
          class="rounded-md"
        />
      </div>
    </div>
  )
}
