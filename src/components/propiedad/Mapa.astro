---
/**
 * Mapa.astro
 * Las coordenadas llegan resueltas desde el build (lib/geocodificar.ts).
 */
import { MapIcon } from "@lucide/astro";
import type { Coordenadas } from "@lib/geocodificar";

interface Props {
  coords: Coordenadas | null;
  slug: string;
  tipo: string;
}

const { coords, slug, tipo } = Astro.props;
const exacta = tipo === "Departamento" && coords?.precision === "direccion";
---

<div class="mb-2">
  <div class="card card-xl shadow-sm bg-stone-900 mt-2 md:mt-0 p-6 rounded-md overflow-hidden relative group">
    <!-- Barra de herramientas del mapa -->
    <div class="flex justify-between items-center mb-4">
         <div class="flex items-center gap-2">
             <div class={`w-2 h-2 rounded-full animate-pulse ${exacta ? 'bg-green-500' : 'bg-primary'}`}></div>
             <h3 class="text-stone-400 text-[10px] font-bold uppercase tracking-[0.2em]">{exacta ? 'Ubicación exacta' : 'Ubicación aproximada'}</h3>
         </div>
         {coords && (
           <a href={`/mapa/${slug}`}
              class="flex items-center gap-2 text-stone-500 hover:text-white transition-all text-[10px] font-bold uppercase tracking-widest bg-stone-800 hover:bg-stone-700 px-3 py-1.5 rounded-full border border-stone-700 shadow-sm">
              <MapIcon class="w-3 h-3" />
              <span>Ver Mapa Completo</span>
           </a>
         )}
    </div>

    <div id="property-map"
         style="height: 450px; width: 100%;"
         class="rounded-md bg-stone-800 flex items-center justify-center relative z-0 transition-all duration-500"
         data-lat={coords?.lat}
         data-lon={coords?.lon}
         data-precision={coords?.precision}
         data-exacta={exacta ? "true" : undefined}>
      {!coords && (
        <div class="p-10 text-center text-xs opacity-50 uppercase tracking-widest">Ubicación no disponible</div>
      )}
    </div>
  </div>
</div>

<style is:global>
  /* Aseguramos que los controles de Leaflet no interfieran con el diseño general */
  .leaflet-container {
    font-family: inherit !important;
  }
  .leaflet-control-attribution {
      font-size: 8px !important;
  }
</style>

{coords && (
  <Fragment>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script is:inline>
      (() => {
        const el = document.getElementById('property-map');
        if (!el || el._leaflet_id || typeof L === 'undefined') return;

        const coords = [parseFloat(el.dataset.lat), parseFloat(el.dataset.lon)];
        const exacta = el.dataset.exacta === 'true';
        const zoom = el.dataset.precision === 'ciudad' ? 13 : exacta ? 18 : 17;

        const map = L.map(el, { zoomControl: true, scrollWheelZoom: false }).setView(coords, zoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '© OpenStreetMap'
        }).addTo(map);

        if (exacta) {
          L.marker(coords).addTo(map);
        } else if (el.dataset.precision === 'direccion') {
          L.circle(coords, { color: '#ef4444', fillColor: '#ef4444', fillOpacity: 0.2, weight: 1.5, radius: 100 }).addTo(map);
        }
      })();
    </script>
  </Fragment>
)}
