---
/**
 * Mapa.astro
 */
const { mapa, slug, tipo } = Astro.props;
---

{
  mapa && (
    <div class="mb-2">
      <div class="card card-xl shadow-sm bg-stone-900 mt-2 md:mt-0 p-6 rounded-md overflow-hidden relative group">
        <!-- Barra de herramientas del mapa -->
        <div class="flex justify-between items-center mb-4">
             <div class="flex items-center gap-2">
                 <div class={`w-2 h-2 rounded-full animate-pulse ${tipo === 'Departamento' ? 'bg-green-500' : 'bg-primary'}`}></div>
                 <h3 class="text-stone-400 text-[10px] font-bold uppercase tracking-[0.2em]">{tipo === 'Departamento' ? 'Ubicación exacta' : 'Ubicación aproximada'}</h3>
             </div>
             <a id="btn-external-map" 
                href="#" 
                target="_blank" 
                class="flex items-center gap-2 text-stone-500 hover:text-white transition-all text-[10px] font-bold uppercase tracking-widest bg-stone-800 hover:bg-stone-700 px-3 py-1.5 rounded-full border border-stone-700 shadow-sm">
                <i data-lucide="map" class="w-3 h-3"></i>
                <span>Ver Mapa Completo</span>
             </a>
        </div>

        <div id="property-map" 
             style="height: 450px; width: 100%;" 
             class="rounded-md bg-stone-800 flex items-center justify-center relative z-0 transition-all duration-500" 
             data-address={mapa}
             data-id={slug}
             data-type={tipo}>
             

             <!-- Loader / Placeholder -->
             <div id="map-loader" class="hidden absolute inset-0 bg-stone-800 flex items-center justify-center text-stone-500 font-bold uppercase tracking-[0.2em] text-[10px] animate-pulse z-10">
                Localizando área...
             </div>
        </div>
      </div>
    </div>
  )
}

<style is:global>
  /* Aseguramos que los controles de Leaflet no interfieran con el diseño general */
  .leaflet-container {
    font-family: inherit !important;
  }
  .leaflet-control-attribution {
      font-size: 8px !important;
  }

  /* Estilo nativo para pantalla completa - Evita saltos de JS */
  #property-map:fullscreen {
      width: 100vw !important;
      height: 100vh !important;
      background-color: #1c1917; /* stone-900 */
      border-radius: 0 !important;
  }
</style>

<!-- Cargamos Leaflet y Lucide desde CDN -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline src="https://unpkg.com/lucide@latest"></script>

<script is:inline>
  window.mapStorage = window.mapStorage || { coords: {} };

  function initPropertyMap() {
    const mapElement = document.getElementById('property-map');
    if (!mapElement) return;

    const mapId = mapElement.dataset.id;
    const address = mapElement.dataset.address;
    if (!mapId || !address || address.trim() === '' || address.trim() === '+') return;

    // Evitar doble inicialización si el elemento ya tiene ID de Leaflet
    if (mapElement._leaflet_id) return;

    const clearLoader = () => {
        const loader = document.getElementById('map-loader');
        if (loader) loader.classList.add('hidden');
    };

    const showLoader = () => {
        const loader = document.getElementById('map-loader');
        if (loader) loader.classList.remove('hidden');
    };

    const drawMap = (data) => {
        if (mapElement._leaflet_id) return;
        clearLoader();
        const coords = [parseFloat(data[0].lat), parseFloat(data[0].lon)];

        const isDept = mapElement.dataset.type === 'Departamento';

        const map = L.map('property-map', {
            zoomControl: true,
            scrollWheelZoom: false
        }).setView(coords, isDept ? 18 : 17);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        if (isDept) {
            // Ubicación exacta para departamentos
            L.marker(coords).addTo(map);
        } else {
            // Ubicación aproximada para el resto
            L.circle(coords, { color: '#ef4444', fillColor: '#ef4444', fillOpacity: 0.2, weight: 1.5, radius: 100 }).addTo(map);
        }

        const btnExternal = document.getElementById('btn-external-map');
        if (btnExternal) {
            btnExternal.target = "_self";
            btnExternal.href = `/mapa${mapId.startsWith('/') ? '' : '/'}${mapId}`;
        }
    };

    // Si los datos ya están en caché, dibujamos SIN ESPERAR a promesas (síncrono)
    if (window.mapStorage.coords[mapId]) {
        drawMap(window.mapStorage.coords[mapId]);
        return;
    }

    // Si no, geocodificamos normalmente
    const cleaned = address.replace(/\s(of|oficina|depto|departamento|local|casa|sitio|lote|block|torre)\s?\.?\s?\w*/gi, '').replace(/\+/g, ' ').trim();
    showLoader();
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(cleaned)}&limit=1`)
        .then(res => res.json())
        .then(data => {
            if (data && data.length > 0) {
                window.mapStorage.coords[mapId] = data;
                drawMap(data);
            } else {
                // Segundo intento fallback
                const fallback = cleaned.split(' ').slice(-1)[0];
                return fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(fallback)}&limit=1`)
                    .then(res => res.json())
                    .then(d2 => {
                        if (d2 && d2.length > 0) {
                            window.mapStorage.coords[mapId] = d2;
                            drawMap(d2);
                        } else {
                            clearLoader();
                            mapElement.innerHTML = '<div class="p-10 text-center text-xs opacity-50 uppercase tracking-widest">Ubicación no disponible</div>';
                        }
                    });
            }
        }).catch(() => clearLoader());
  }

  const initLucide = () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  };

  const check = () => {
      if (typeof L !== 'undefined' && typeof lucide !== 'undefined') {
          initPropertyMap();
          initLucide();
      } else {
          setTimeout(check, 100);
      }
  };

  document.addEventListener('astro:page-load', check);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', check);
  else check();
</script>
