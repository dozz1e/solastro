---
import { VolumeOff, Volume2 } from "@lucide/astro";
const { src } = Astro.props;
---

<div class="relative w-full lg:w-2xs">
  <button
    type="button"
    id="buttonvolume"
    class="absolute right-0 bottom-0 z-10 flex items-center justify-center w-11 h-11 cursor-pointer"
    aria-label="Activar sonido del video"
    aria-pressed="false"
  >
    <span id="volumeoff" aria-hidden="true">
      <VolumeOff />
    </span>
    <span id="volume" class="hidden" aria-hidden="true">
      <Volume2 />
    </span>
  </button>
  <video src={src} class="video rounded-md" id="video" autoplay loop muted
  ></video>
</div>

<script>
  const boton = document.getElementById("buttonvolume");
  const volume = document.getElementById("volume");
  const volumeoff = document.getElementById("volumeoff");
  const video = document.getElementById("video") as HTMLVideoElement;

  boton.addEventListener("click", function () {
    video.muted = !video.muted;
    volume.classList.toggle("hidden", video.muted);
    volumeoff.classList.toggle("hidden", !video.muted);
    boton.setAttribute("aria-pressed", String(!video.muted));
    boton.setAttribute(
      "aria-label",
      video.muted ? "Activar sonido del video" : "Silenciar video",
    );
  });
</script>
