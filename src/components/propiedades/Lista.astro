---
import { removeNumbers } from "@utils/format";
const { imagen, ciudad, direccion: rawDireccion, slug } = Astro.props;
const direccion = removeNumbers(rawDireccion);
// Normalizar el slug para evitar doble barra en las URLs (ej: /propiedades//slug)
const cleanSlug = slug.startsWith('/') ? slug.slice(1) : slug;
---

<li class="hover:bg-gray-700">
  <a href={`/propiedades/${cleanSlug}`} class="list-row p-2">
    <div>
      <img
        class="w-16 h-10 rounded-sm object-cover"
        src={imagen}
        alt={direccion}
        width="800"
        height="500"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <div class="lista-propiedad">{direccion}</div>
      <div class="text-xs uppercase text-gray-400">{ciudad}</div>
    </div>
  </a>
</li>

<style>
  li:hover {
    .lista-propiedad {
      color: ghostwhite;
    }
  }
</style>
