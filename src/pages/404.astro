---
import Layout from "@layouts/Layout.astro";
import type { Seo } from "@interfaces/Seo";

const seo: Seo = {
  title: "Página no encontrada | MarSol Propiedades",
  description:
    "La página que buscas no existe o fue movida. Vuelve al inicio y sigue explorando nuestras propiedades.",
  url: "https://marsolpropiedades.cl/404",
  image: "https://marsolpropiedades.cl/logos/logo-completo.jpg",
  keywords: ["404", "página no encontrada", "marsolpropiedades"],
};
---

<Layout dataPag={seo}>
  <div class="not-found-wrapper">
    <div class="not-found-container">

      <!-- Número 404 animado -->
      <div class="number-block">
        <span class="num">4</span>
        <span class="house-icon">
          <img src="/favicon.svg" alt="Marsol ícono" class="house-svg" />
        </span>
        <span class="num">4</span>
      </div>

      <!-- Texto principal -->
      <h1 class="not-found-title">Propiedad no encontrada</h1>
      <p class="not-found-desc">
        La página que buscas no existe o fue removida.<br />
        Pero no te preocupes, tenemos muchas propiedades esperándote.
      </p>

      <!-- Acciones -->
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary btn-lg rounded-xl px-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7m-9 5v6h4v-6m-4 0H9m4 0h2" />
          </svg>
          Volver al inicio
        </a>
        <a href="/propiedades" class="btn btn-outline btn-lg rounded-xl px-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
          </svg>
          Ver propiedades
        </a>
      </div>

      <!-- Links de navegación rápida -->
      <div class="quick-links">
        <span class="quick-links-label">También puedes visitar:</span>
        <div class="quick-links-list">
          <a href="/servicios" class="badge badge-outline badge-lg">Servicios</a>
          <a href="/nosotros" class="badge badge-outline badge-lg">Nosotros</a>
          <a href="/contacto" class="badge badge-outline badge-lg">Contacto</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .not-found-wrapper {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
  }

  .not-found-container {
    text-align: center;
    max-width: 640px;
    width: 100%;
    animation: fadeInUp 0.6s ease both;
  }

  /* Bloque del número 404 */
  .number-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .num {
    font-family: "Poppins", sans-serif;
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, oklch(var(--p)), oklch(var(--s)));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 4px 24px oklch(var(--p) / 0.35));
  }

  .house-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .house-svg {
    width: clamp(4rem, 14vw, 8rem);
    animation: floatBounce 3s ease-in-out infinite;
    filter: drop-shadow(0 8px 24px oklch(var(--p) / 0.4));
  }

  /* Título */
  .not-found-title {
    font-family: "Poppins", sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: oklch(var(--bc));
  }

  /* Descripción */
  .not-found-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: oklch(var(--bc) / 0.7);
    margin-bottom: 2.5rem;
  }

  /* Botones de acción */
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  /* Links rápidos */
  .quick-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .quick-links-label {
    font-size: 0.875rem;
    color: oklch(var(--bc) / 0.5);
  }

  .quick-links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  /* Animaciones */
  @keyframes floatBounce {
    0%, 100% { transform: translateY(0px) rotate(-2deg); }
    50%       { transform: translateY(-14px) rotate(2deg); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
