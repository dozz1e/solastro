---
import { propiedades } from "@lib/propiedades";
import LayoutPropiedad from "@layouts/LayoutPropiedad.astro";
import { obtenerCoordenadas } from "@lib/geocodificar";
import { removeNumbers } from "@utils/format";

export async function getStaticPaths() {
  return propiedades.map((propiedad) => ({
    params: { slug: propiedad.slug.replace(/^\//, '') },
    props: { propiedad },
  }));
}

const { propiedad } = Astro.props;
const cleanTitle = removeNumbers(propiedad.title);

// Normalizamos el slug para evitar doble barra en los enlaces de retorno
const cleanSlug = propiedad.slug.replace(/^\//, "");

const coords = await obtenerCoordenadas(
  propiedad.direccion.direccion,
  propiedad.direccion.ciudad,
);
const exacta =
  propiedad.categoriaGraphql.categoria[0] === "Departamento" &&
  coords?.precision === "direccion";

const seo = {
  title: `Mapa de ${cleanTitle} - MarSol Propiedades`,
  description: `Ubicación aproximada de ${cleanTitle} en ${propiedad.direccion.ciudad}.`,
  url: `https://marsolpropiedades.cl/mapa/${cleanSlug}`,
  image: `https://marsolpropiedades.cl/images/propiedades/${cleanSlug}/1.jpg`,
  keywords: ["mapa", "ubicación", propiedad.direccion.ciudad]
};
---

<LayoutPropiedad dataPag={seo}>
    <div class="h-screen w-screen flex flex-col bg-stone-900 overflow-hidden">
        <!-- Header minimalista para volver -->
        <div class="p-4 bg-black/80 backdrop-blur-md flex justify-between items-center z-[3000]">
             <a href={`/propiedades/${cleanSlug}`} class="flex items-center gap-2 text-white hover:text-primary transition-colors text-sm font-bold uppercase tracking-widest">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                <span>Volver a la Propiedad</span>
             </a>
             <div class="hidden md:block text-stone-400 text-xs uppercase tracking-tighter">
                {cleanTitle}
             </div>
        </div>

        <!-- El mapa a pantalla completa real -->
        <div class="flex-1 w-full relative">
            <div id="full-property-map"
                 class="w-full h-full"
                 data-lat={coords?.lat}
                 data-lon={coords?.lon}
                 data-precision={coords?.precision}
                 data-exacta={exacta ? "true" : undefined}>
            </div>

            {!coords && (
              <div class="absolute inset-0 z-[2000] bg-stone-900 flex items-center justify-center text-stone-500 font-bold uppercase tracking-[0.2em] text-sm">
                  Ubicación no disponible
              </div>
            )}
        </div>
    </div>
</LayoutPropiedad>

{coords && (
  <Fragment>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script is:inline>
      (() => {
        const el = document.getElementById('full-property-map');
        if (!el || el._leaflet_id || typeof L === 'undefined') return;

        const coords = [parseFloat(el.dataset.lat), parseFloat(el.dataset.lon)];
        const exacta = el.dataset.exacta === 'true';
        const zoom = el.dataset.precision === 'ciudad' ? 13 : exacta ? 18 : 17;

        const map = L.map(el, { zoomControl: true }).setView(coords, zoom);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);

        if (exacta) {
          L.marker(coords).addTo(map);
        } else if (el.dataset.precision === 'direccion') {
          L.circle(coords, { color: '#ef4444', fillColor: '#ef4444', fillOpacity: 0.2, weight: 1.5, radius: 100 }).addTo(map);
        }
      })();
    </script>
  </Fragment>
)}

<style is:global>
    body { overflow: hidden; }
</style>
